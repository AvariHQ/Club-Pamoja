# Canonical origin used for canonical URLs, Open Graph and the sitemap.
PUBLIC_SITE_URL=https://clubpamoja.com

# Verified member-portal sign-in URL. REQUIRED before launch.
# When empty, "Member Sign In" points to the internal /sign-in/ handoff page.
PUBLIC_PORTAL_URL=

# Destination of the membership application (external system). REQUIRED before launch.
# When empty, "Apply for Membership" points to /how-to-join/#apply.
PUBLIC_APPLY_URL=

# Authoritative bylaws document URL (e.g. /documents/club-pamoja-bylaws.pdf). REQUIRED before launch.
PUBLIC_BYLAWS_URL=

# Public contact address. When empty the contact page shows a review marker.
PUBLIC_CONTACT_EMAIL=

# Set to "false" to hide the Open Enrollment announcement bar site-wide.
PUBLIC_OPEN_ENROLLMENT=true

# Set to "true" to render inline content-review markers (use on staging, never production).
PUBLIC_SHOW_REVIEW_NOTES=false
