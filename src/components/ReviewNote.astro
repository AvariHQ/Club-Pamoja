---
/**
 * Content-review marker. Every instance must also be listed in docs/CONTENT-REVIEW.md
 * under the same id. Renders only when PUBLIC_SHOW_REVIEW_NOTES=true (staging).
 * In production the surrounding copy must still read correctly without it.
 */
import { site } from '../config/site';
interface Props { id: string }
const { id } = Astro.props;
---
{site.showReviewNotes && (
  <aside class="review-note" data-review-id={id} aria-label={`Content review ${id}`}>
    <strong>Content review · {id}</strong> <slot />
  </aside>
)}
<style>
  .review-note {
    margin-block: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-warning-bg);
    border: 1px dashed var(--color-warning-border);
    border-radius: var(--radius-sm);
    color: #4a3a0c;
    font-family: var(--font-body);
    font-size: var(--step--1);
    line-height: 1.5;
    text-align: left;
  }
  .review-note strong { text-transform: uppercase; letter-spacing: .06em; }
</style>
