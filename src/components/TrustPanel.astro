---
/** StatelessTrustPanel — institutional trust facts. Only verified statements. */
const items = [
  { title: 'Mutual aid, not insurance', body: 'Members support members. No policies, premiums or underwriting.', href: '/legal/', link: 'Legal status' },
  { title: 'Governed by written bylaws', body: 'Membership, contributions and support operate under published rules.', href: '/governance/', link: 'Governance' },
  { title: 'Transparent administration', body: 'Fixed, published amounts and accountable records.', href: '/transparency/', link: 'Transparency' },
  { title: 'Privacy by design', body: 'Member and family records are held in a separate member portal, not on this website.', href: '/safety/', link: 'Safety & privacy' },
  { title: 'Shared responsibility', body: 'Every member contributes when called. That is what makes the community dependable.', href: '/membership/#responsibilities', link: 'Member responsibilities' },
];
---
<ul class="trust">
  {items.map((it, i) => (
    <li class="trust__item" data-reveal style={`transition-delay:${i * 50}ms`}>
      <h3>{it.title}</h3>
      <p>{it.body}</p>
      <a href={it.href} class="text-link">{it.link}<span class="visually-hidden">: {it.title}</span></a>
    </li>
  ))}
</ul>
<style>
  .trust { list-style: none; padding: 0; display: grid; gap: var(--space-5); }
  @media (min-width: 640px) { .trust { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .trust { grid-template-columns: repeat(5, 1fr); gap: var(--space-5); } }
  .trust__item { padding-top: var(--space-5); border-top: 2px solid var(--cp-teal-900); display: flex; flex-direction: column; gap: var(--space-3); }
  .trust__item h3 { font-size: var(--step-1); line-height: 1.3; }
  .trust__item p { color: var(--color-text-muted); font-size: .9375rem; flex: 1; }
  .trust__item .text-link { font-size: .9375rem; align-self: flex-start; }
</style>
