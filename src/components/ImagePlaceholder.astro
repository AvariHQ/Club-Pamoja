---
/**
 * Renders a final campaign image when `src` is set in data/assets.ts,
 * otherwise a TEMPORARY, intentionally designed placeholder panel.
 * Placeholder labels are visible only when review notes are enabled.
 */
import { assets } from '../data/assets';
import { site } from '../config/site';

interface Props { id: string; eager?: boolean; class?: string; sizes?: string }
const { id, eager = false, class: cls = '', sizes = '(min-width: 1024px) 50vw, 100vw' } = Astro.props;
const spec = assets[id];
if (!spec) throw new Error(`Unknown asset id ${id}`);
const style = `--ar:${spec.aspect};--ar-m:${spec.mobileAspect}`;
const widths = [640, 960, 1440];
---
<figure class:list={['media', cls]} style={style} data-asset={id}>
  {spec.src ? (
    <picture>
      <source type="image/avif" srcset={widths.map((w) => `${spec.src}-${w}.avif ${w}w`).join(', ')} sizes={sizes} />
      <source type="image/webp" srcset={widths.map((w) => `${spec.src}-${w}.webp ${w}w`).join(', ')} sizes={sizes} />
      <img src={`${spec.src}-960.jpg`} alt={spec.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} width="960" height="720" />
    </picture>
  ) : (
    <div class="media__placeholder" role="img" aria-label={spec.alt}>
      <!-- TEMPORARY PLACEHOLDER: {id} — see src/data/assets.ts -->
      <svg viewBox="0 0 200 200" aria-hidden="true" class="media__mark">
        <circle cx="80" cy="100" r="54" fill="none" stroke="currentColor" stroke-width="1" />
        <circle cx="120" cy="100" r="54" fill="none" stroke="#C8A770" stroke-width="1" />
      </svg>
      {site.showReviewNotes && <span class="media__label">{id} · temporary placeholder<br />{spec.section}</span>}
    </div>
  )}
</figure>

<style>
  .media { position: relative; aspect-ratio: var(--ar-m); overflow: hidden; border-radius: var(--radius-md); background: var(--cp-teal-800); }
  @media (min-width: 768px) { .media { aspect-ratio: var(--ar); } }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .media__placeholder {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    color: rgba(255, 255, 255, 0.28);
    background:
      radial-gradient(120% 90% at 85% 10%, rgba(200, 167, 112, 0.22), transparent 55%),
      radial-gradient(90% 80% at 10% 100%, rgba(45, 93, 105, 0.7), transparent 60%),
      var(--cp-teal-900);
  }
  .media__mark { width: min(46%, 220px); }
  .media__label {
    position: absolute; left: var(--space-3); bottom: var(--space-3);
    padding: var(--space-1) var(--space-2);
    background: var(--color-warning-bg); color: #4a3a0c;
    font-size: 11px; font-weight: 650; letter-spacing: .05em; text-transform: uppercase; line-height: 1.4;
    border-radius: 2px;
  }
</style>
