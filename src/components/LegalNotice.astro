---
/** Formal notice block for legal or governing-document summaries. Always links to the authoritative source. */
interface Props { source?: { label: string; href: string } }
const { source = { label: 'Club Pamoja bylaws', href: '/bylaws/' } } = Astro.props;
---
<aside class="legal-notice" aria-label="Legal notice">
  <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8.5" fill="none" stroke="currentColor" /><path d="M10 9v5M10 6.2v.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
  <p>
    This page summarizes Club Pamoja rules in plain language. It does not replace them. Where this summary and the
    {' '}<a href={source.href}>{source.label}</a> differ, the {source.label} govern.
  </p>
</aside>
<style>
  .legal-notice { display: flex; gap: var(--space-3); padding: var(--space-4) var(--space-5); border: var(--border); border-radius: var(--radius-md); background: var(--cp-white); font-size: .9375rem; color: var(--color-text-muted); }
  .legal-notice svg { flex: none; width: 1.25rem; height: 1.25rem; margin-top: .2rem; color: var(--cp-teal-700); }
</style>
